# Moroccan Cosmetics — Apache (cPanel / static export in public_html)
<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -Indexes

  # HTTP → HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www → apex (keep path)
  RewriteCond %{HTTP_HOST} ^www\.moroccan-cosmetics\.com$ [NC]
  RewriteRule ^ https://moroccan-cosmetics.com%{REQUEST_URI} [R=301,L]

  # Serve real files and folders as-is: /_next/, /images/, logo, robots, sitemap, etc.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Exactly "/" → English home
  RewriteRule ^$ /en/ [R=301,L]

  # Locale home: /en or /en/ → en/index.html
  RewriteRule ^(en|fr|ar)/?$ $1/index.html [L]

  # Pretty URLs: /en/contact/ → en/contact/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>
