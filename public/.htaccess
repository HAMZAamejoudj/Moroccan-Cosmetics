RewriteEngine On
Options -Indexes

# Redirect domain root to English homepage
RewriteRule ^$ /en/ [R=301,L]

# Backward compatibility for old asset paths
RewriteRule ^_next/(.*)$ /next-assets/$1 [L]

# Locale home: /en or /en/ → en/index.html
RewriteRule ^(en|fr|ar)/?$ $1/index.html [L]

# Other pages: /en/contact/ → en/contact/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]
